# s4-ids.rules — three Suricata rules for exercise 8. Read them before you run them.
# Anatomy:  action protocol source port -> destination port (options; sid:unique-number;)

# 1. Someone asks the web server for a system file
alert http any any -> any any (msg:"S4 web attack: request for /etc/passwd"; http.uri; content:"/etc/passwd"; sid:4000001; rev:1;)

# 2. Someone from outside tries to open SSH on our servers
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"S4 SSH attempt from outside"; flags:S; sid:4000002; rev:1;)

# 3. Many new connections from one source in a few seconds: a port scan (one alert per 10s, not one per packet)
alert tcp any any -> $HOME_NET any (msg:"S4 port scan (20 SYN in 10s from one source)"; flags:S; threshold: type both, track by_src, count 20, seconds 10; sid:4000003; rev:1;)
